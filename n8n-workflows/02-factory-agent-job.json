      "id": "a77e4951-add9-5189-b3a1-b24d87eb6b6c",
      "name": "Job abfragen",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        300,
        150
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const status=$input.first().json;\nconst attempt=$runIndex+1;\nconst limit=$('Auftrag konfigurieren').first().json.max_poll_attempts;\nconst pending=['running','pending'].includes(status.status);\nreturn [{json:{...status,poll_count:attempt,continue_polling:pending&&attempt<limit,poll_limit_reached:pending&&attempt>=limit}}];"
      },
      "id": "f05d0dd1-3aa4-5cbf-9dab-411e21ebd69d",
      "name": "Status auswerten",
