        "jsCode": "const j=$input.first().json;\nreturn [{json:{outcome:'poll_limit_cancelled',job_id:j.job_id,provider:j.provider,role:j.role,status:j.status,exit_code:j.exit_code,result:j.result||null,logs_tail:j.logs_tail||null,info:'Polling-Limit erreicht. Stop wurde angefordert.'}}];"
      },
