      "id": "4a695eab-6aa5-54a9-aaf7-c873e9d23431",
      "name": "Auftrag konfigurieren",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -670,
        150
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const x=$input.first().json;\nconst providers=['codex','claude','gemini'];\nconst roles=['smoke','requirements','architect','developer','tester','reviewer','security'];\nif (!providers.includes(x.provider)) throw new Error('Unbekannter provider: '+x.provider);\nif (!roles.includes(x.role)) throw new Error('Unbekannte role: '+x.role);\nif (typeof x.task!=='string'||x.task.length>12000||(x.role!=='smoke'&&!x.task.trim())) throw new Error('task ungueltig oder leer');\nif (!Number.isInteger(x.timeout_seconds)||x.timeout_seconds<10||x.timeout_seconds>1800) throw new Error('timeout_seconds muss 10 bis 1800 sein (und <= FACTORY_AGENT_MAX_TIMEOUT_SEC).');\nif (!Number.isInteger(x.max_poll_attempts)||x.max_poll_attempts<1||x.max_poll_attempts>1000) throw new Error('max_poll_attempts muss zwischen 1 und 1000 liegen.');\nif (x.ref&&!x.repository) throw new Error('ref erfordert repository');\nconst request={provider:x.provider,role:x.role,task:x.task,timeout_seconds:x.timeout_seconds};\nif (x.repository) request.repository=x.repository;\nif (x.ref) request.ref=x.ref;\nreturn [{json:{...x,request}}];"
      },
      "id": "1468f8b6-5b64-5c32-80a1-4427d2f51bc1",
      "name": "Auftrag validieren",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -430,
        150
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://agent-manager:8080/jobs",
        "options": {},
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.request) }}"
      },
