    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const health = $('Manager Health').first().json;\nconst catalog = $('Agent-Katalog').first().json;\nconst apiJobs = $input.first().json;\nconst jobs = Array.isArray(apiJobs.jobs) ? apiJobs.jobs : [];\nconst active = jobs.filter(j => ['running', 'created', 'restarting', 'pending'].includes(j.docker_status || j.status)).length;\nconst logins = Object.fromEntries((catalog.providers || []).map(provider => {\n  const roles = catalog.logins?.[provider] || {};\n  return [provider, Object.fromEntries(Object.entries(roles).map(([role, r]) => [role, !!r.ready]))];\n}));\nreturn [{json:{\n  factory:'factory',\n  status:health.status || 'unknown',\n  docker:health.docker || 'unknown',\n  providers:catalog.providers || [],\n  roles:catalog.roles || [],\n  worker_images:catalog.images || {},\n  login_readiness:logins,\n  job_count:jobs.length,\n  active_job_count:active,\n  jobs:jobs,\n  note:'Login readiness is informational. Smoke agents need no AI login.'\n}}];"
      },
      "id": "ad11170f-a24a-5fed-a3f4-59c1bc0c05a5",
