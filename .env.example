# TEMPLATE ONLY: no real credentials. Use the generated .env from a full ZIP for new installations.
# FACTORY - complete local HTTP deployment configuration
# NEVER commit your filled .env to Git. Keep all real secrets there.

# Entire Docker Compose project
FACTORY_NAME=factory
FACTORY_RESTART_POLICY=unless-stopped

# Docker images (pinned for reproducibility)
N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.48.5
POSTGRES_IMAGE=postgres:17-alpine

# Host networking: 127.0.0.1 = only this machine; 0.0.0.0 = LAN access
FACTORY_BIND_IP=127.0.0.1
FACTORY_HTTP_PORT=5678

# PostgreSQL: only accessible from the internal Factory network
POSTGRES_DB=n8n
FACTORY_DB_NAME=n8n
POSTGRES_USER=n8n
FACTORY_DB_USER=n8n
POSTGRES_PASSWORD=
# Legacy-compatible alias; MUST equal POSTGRES_PASSWORD:
FACTORY_DB_PASSWORD=

# n8n database connection
DB_TYPE=postgresdb
DB_POSTGRESDB_HOST=postgres
DB_POSTGRESDB_PORT=5432

# n8n HTTP access (for a LAN server, replace localhost with server IP in ALL 3 fields)
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678/
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false

# n8n encryption, runtime and privacy
# IMPORTANT: Never change N8N_ENCRYPTION_KEY once credentials are stored!
N8N_ENCRYPTION_KEY=
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_BLOCK_ENV_ACCESS_IN_NODE=true
N8N_DIAGNOSTICS_ENABLED=false
GENERIC_TIMEZONE=Europe/Berlin
TZ=Europe/Berlin

# --- Factory Agent Manager (internal only; never exposed on host) ---
FACTORY_AGENT_MANAGER_IMAGE=factory-agent-manager:local
FACTORY_AGENT_MANAGER_PORT=8080
FACTORY_AGENT_IMAGE_PREFIX=factory-agent
FACTORY_AGENT_IMAGE_TAG=local
FACTORY_CODEX_VERSION=latest
FACTORY_DOCKER_SOCKET=/var/run/docker.sock
FACTORY_AGENT_API_TOKEN=
FACTORY_AGENT_MAX_CONCURRENT=3
FACTORY_AGENT_DEFAULT_TIMEOUT_SEC=900
FACTORY_AGENT_MAX_TIMEOUT_SEC=1800
FACTORY_AGENT_RETENTION_SEC=7200
FACTORY_AGENT_MEMORY_MB=1536
FACTORY_AGENT_CPUS=2.0
FACTORY_AGENT_PIDS_LIMIT=256
FACTORY_CODEX_SANDBOX=workspace-write

# Codex uses ChatGPT login sessions in host bind directories, NOT an OpenAI API key.
# You can assign each role a separate login profile for parallel execution.
# Allowed: default, requirements, architect, developer, tester, reviewer, security.
FACTORY_CODEX_PROFILE_REQUIREMENTS=default
FACTORY_CODEX_PROFILE_PLANNER=default
FACTORY_CODEX_PROFILE_ARCHITECT=default
FACTORY_CODEX_PROFILE_DEVELOPER=default
FACTORY_CODEX_PROFILE_TESTER=default
FACTORY_CODEX_PROFILE_REVIEWER=default
FACTORY_CODEX_PROFILE_SECURITY=default

# Optional: separate credential for cloning PRIVATE GitHub repositories only.
FACTORY_GITHUB_TOKEN=

# v4: Per-provider worker images; update one using ./factory.sh update-worker claude
FACTORY_CLAUDE_VERSION=latest
FACTORY_GEMINI_VERSION=latest
# Permissions: approve file edits, but not arbitrary shell execution.
FACTORY_CLAUDE_PERMISSION_WRITE=acceptEdits
FACTORY_GEMINI_APPROVAL_WRITE=auto_edit

# Separate login profiles for Claude and Gemini (all roles use default until changed).
FACTORY_CLAUDE_PROFILE_REQUIREMENTS=default
FACTORY_CLAUDE_PROFILE_PLANNER=default
FACTORY_CLAUDE_PROFILE_ARCHITECT=default
FACTORY_CLAUDE_PROFILE_DEVELOPER=default
FACTORY_CLAUDE_PROFILE_TESTER=default
FACTORY_CLAUDE_PROFILE_REVIEWER=default
FACTORY_CLAUDE_PROFILE_SECURITY=default
FACTORY_GEMINI_PROFILE_REQUIREMENTS=default
FACTORY_GEMINI_PROFILE_PLANNER=default
FACTORY_GEMINI_PROFILE_ARCHITECT=default
FACTORY_GEMINI_PROFILE_DEVELOPER=default
FACTORY_GEMINI_PROFILE_TESTER=default
FACTORY_GEMINI_PROFILE_REVIEWER=default
FACTORY_GEMINI_PROFILE_SECURITY=default

# Factory v5: host bind mounts. Paths may be absolute or relative to factory/.
# Prefer a Linux filesystem when using WSL2 (native UID/GID semantics).
FACTORY_POSTGRES_DATA_DIR=./data/postgres
FACTORY_N8N_DATA_DIR=./data/n8n
# Source directory for importable n8n workflow JSON files (read-only inside n8n).
FACTORY_N8N_WORKFLOWS_DIR=./n8n-workflows
# "owner" = persoenliches Projekt des n8n-Administrators; alternativ explizite Projekt-ID.
FACTORY_N8N_IMPORT_PROJECT_ID=owner
# Automatic import on Factory start; additionally detects changed JSON files.
FACTORY_N8N_AUTO_IMPORT=true
# Frequency in seconds; only changed JSON files are re-imported.
FACTORY_N8N_SYNC_INTERVAL_SEC=20
FACTORY_N8N_SYNC_IMPORT_TIMEOUT_SEC=180
# Separate persistent state/config for the importer, NEVER a Docker volume.
FACTORY_N8N_SYNC_DATA_DIR=./data/n8n-workflow-sync
FACTORY_AUTH_DATA_DIR=./data/auth
FACTORY_WORKSPACE_DATA_DIR=./data/workspaces
# Usually auto detects the invoking user (also when factory.sh runs with sudo).
# Override with numeric UID/GID only if Docker user namespaces require it.
FACTORY_WORKSPACE_OWNER_UID=auto
FACTORY_WORKSPACE_OWNER_GID=auto

# Internal network for service communication; distinct Internet-egress bridge
# for n8n and on-demand workers. Docker bridge ICC disabled on egress.
FACTORY_INTERNAL_NETWORK=factory_internal
FACTORY_EGRESS_NETWORK=factory_egress

# Factory v5.7: allowed parent directories for the destructive data reset.
# Colon-separated; configured data directories must be strictly below one root.
# Add other roots explicitly when using external absolute bind mount paths.
# Workflow source files are NOT part of the reset.
FACTORY_RESET_ALLOWED_ROOTS=./data

# Factory v5.9: GitHub repository registry + Projects Status (private repo with repos/*.repo)
# GitHub Token: Contents READ on registry; Issues READ/WRITE on target repositories; GitHub Projects v2 READ/WRITE on boards.
# This is GitHub access ONLY, unrelated to Codex/Claude/Gemini subscriptions.
FACTORY_GITHUB_REGISTRY_IMAGE=factory-github-registry:local
FACTORY_GITHUB_REGISTRY_PORT=8090
FACTORY_GITHUB_REGISTRY_REPO=
FACTORY_GITHUB_REGISTRY_REF=auto
FACTORY_GITHUB_REGISTRY_DIR=repos
FACTORY_GITHUB_REGISTRY_TOKEN=
FACTORY_GITHUB_API_URL=https://api.github.com
FACTORY_GITHUB_API_VERSION=2022-11-28
# Auto-publish only the read-only GitHub polling workflow after it is imported.
# Set true ONLY after token + registry repo are configured.
FACTORY_GITHUB_AUTO_PUBLISH=false

# Factory v5.9: OFF by default until GitHub authorization and AI login are ready.
# Per-repository settings are generated from the Factory defaults above.
# v5.16: Global default behavior for all URL-registered repositories (no per-repo YAML).
FACTORY_GITHUB_DEFAULT_PLANNER_PROVIDER=codex
FACTORY_GITHUB_DEFAULT_DEVELOPER_PROVIDER=codex
FACTORY_GITHUB_DEFAULT_REVIEWER_PROVIDER=claude
FACTORY_GITHUB_DEFAULT_TIMEOUT_SEC=900
FACTORY_GITHUB_DEFAULT_MAX_REVIEW_CYCLES=3
FACTORY_GITHUB_DEFAULT_MAX_PLAN_TASKS=40
# Comma-separated names of required GitHub CI checks; required for auto merge.
FACTORY_GITHUB_DEFAULT_REQUIRED_CHECKS=
FACTORY_GITHUB_DEFAULT_AUTO_MERGE=false
FACTORY_GITHUB_DEFAULT_AUTO_PLAN_ON_CREATE=true
FACTORY_GITHUB_DEFAULT_AUTO_INSTALL_FORMS=true
FACTORY_GITHUB_AUTORUN_ENABLED=false

# v5.11: permit a reviewed, CI-green pull request to merge without a human click.
FACTORY_GITHUB_AUTOMERGE_ENABLED=false

# v5.15: Login-based quota probes. Never runs a model prompt.
FACTORY_LIMIT_MONITOR_ENABLED=true
FACTORY_LIMIT_UNKNOWN_POLICY=block
FACTORY_LIMIT_REFRESH_SEC=300
FACTORY_LIMIT_CHECK_TIMEOUT_SEC=25
FACTORY_LIMIT_MIN_REMAINING_PERCENT=5
FACTORY_LIMIT_CODEX_BUCKETS=codex
FACTORY_LIMIT_MAX_PROBES=3
